@page "/widget/edit/{WidgetId:int}"
@inherits WidgetBasePageClass

<PageTitle>Edit Widget</PageTitle>

@if (!_isLoaded)
{
    <LoadingMessageComponent ValueToShow="@(_entityNotFound
                                                ? WidgetNotFoundMessage
                                                : LoadingWidgetMessage)"
                             IsLoading="@(WidgetModel.WidgetId!= 0)" />
    return;
}

@if (IsColourJustificationError)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
        Colour requires justification
    </MudAlert>
}

<EditForm Model="@WidgetDisplayModel" OnValidSubmit="UpdateWidget">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <WidgetCreateUpdateComponent WidgetDisplayModel="WidgetDisplayModel"
                                 Manufacturers="Manufacturers"
                                 Colours="Colours"
                                 ColourJustifications="ColourJustifications"
                                 WidgetStatuses="WidgetStatuses" />

</EditForm>