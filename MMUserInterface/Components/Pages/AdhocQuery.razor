@page "/adhocquery"
@inherits AdhocQueryBasePageClass

<PageTitle>Ad Hoc Query</PageTitle>

@if (LastXSuccessfulAdhocQueries is null)
{
    <LoadingMessageComponent ValueToShow="@AdhocQueryPlural" />
    return;
}

<MudText Typo="Typo.h3" GutterBottom="true">Ad Hoc Query</MudText>

@if (ShowLastXPanel && LastXSuccessfulAdhocQueries.Any())
{
    <AdhocQueriesListAndRerunComponent LastXSuccessfulAdhocQueries="@LastXSuccessfulAdhocQueries"
                                       OnAdhocQuerySelected="HandleRerunQuery" />    
}

@if (LastXSuccessfulAdhocQueries.Any())
{
    <MudButton Color="Color.Secondary"
           Variant="Variant.Outlined"
           Class="my-3"
           OnClick="@(() => ShowLastXPanel = !ShowLastXPanel)"
           Disabled="@IsThinking">
        @(ShowLastXPanel ? "Hide" : "Show") Last @LastXSuccessfulAdhocQueries.Count @(LastXSuccessfulAdhocQueries.Count == 1 ? AdhocQuerySingular : AdhocQueryPlural)
    </MudButton>
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <MudCardContent>
                <MudTextField Lines="5"
                    T="string"
                    id="txtAdhocQuery"
                    Label="Type your query here"
                    AutoFocus="true"
                    data-testid="adhoc-query-input"
                    @bind-Value="QueryText" />
            </MudCardContent>

            @if (IsRecording)
            {
                <div class="mic-pulse"></div>
            }

            <MudCardActions>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">

                    <MudButton Color="Color.Info"
                               Variant="Variant.Filled"
                               OnClick="@StartSpeechRecognition"
                               Disabled="@(IsRecording || IsThinking)">
                        <MudIcon Icon="@Icons.Material.Filled.Mic" />
                        Speak Query
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@OnClearClicked"
                               Disabled="@IsThinking"
                               StartIcon="@Icons.Material.Filled.Check">
                        Clear
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="@OnQueryClicked"
                               Disabled="@IsThinking"
                               StartIcon="@Icons.Material.Filled.Check">
                        Submit
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                        Color="Color.Default"
                        OnClick="OnCancelClicked"
                        Disabled="!IsThinking"
                        StartIcon="@Icons.Material.Outlined.Cancel">
                        Cancel Request
                    </MudButton>

                </MudStack>

            </MudCardActions>

        </MudCard>
    </MudItem>
</MudGrid>

<MudDivider Class="my-4" />

@if (IsThinking)
{
    <ThinkingComponent />
}

@if (MessageToDisplay is not null)
{
    <MudAlert Severity="Severity.Error" Elevation="0" Variant="Variant.Filled" Class="mb-4">
        @MessageToDisplay
    </MudAlert>
}

@if (ResultsDataTable is not null && !IsThinking)
{
    if (ResultsDataTable.Rows.Count > 0)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   OnClick="ExportCSV"
                   StartIcon="@Icons.Material.Outlined.Download">
            Download as CSV
        </MudButton>
    }    

    <AdHocQueryResultsComponent AdhocQueryResults="ResultsDataTable" />
}